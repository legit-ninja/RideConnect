# Copy to /etc/systemd/system/rideconnect-api.service (prod) on the server.
# Prod API listens on 8009. pydantic-settings loads .env from WorkingDirectory.

[Unit]
Description=RideConnect API (FastAPI) — production
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/phantomequestrian.com/api
Environment=PORT=8009
ExecStart=/var/www/phantomequestrian.com/api/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8009
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
