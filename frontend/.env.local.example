NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side fetches when Next.js runs in Docker (browser still uses localhost above)
# API_INTERNAL_URL=http://host.docker.internal:8000
NEXT_PUBLIC_SITE_NAME=Phantom Equestrian
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SHOP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_LOGO=/branding/mark.png
# Cross-subdomain JWT cookie (leave empty for local /shop path-only)
# NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=.phantomequestrian.com
NEXT_PUBLIC_AUTH_COOKIE_NAME=pe_access_token
